+// --- ttyd sidecar proxy (self-hosted addition; no-op unless TTYD_PORT is set) ---
+// Forwards /ttyd/* (HTTP + WebSocket) to a ttyd process listening on 127.0.0.1,
+// injecting HTTP Basic credentials server-side so the browser never sees them.
+// Header names are lowercase on purpose: Node lowercases incoming headers, and
+// HTTP/1.1 header names are case-insensitive on the wire.
+const TTYD_PORT = Number(process.env.TTYD_PORT ?? 0);
+const TTYD_CREDENTIAL = (() => {
+  const user = process.env.TTYD_USER;
+  const pass = process.env.TTYD_PASS;
+  if (!TTYD_PORT || !user || !pass) return '';
+  return `Basic ${Buffer.from(`${user}:${pass}`).toString('base64')}`;
+})();
+
+/** Inject the Authorization header right after the request line of `buf`. */
+function ttydInjectAuth(buf: Buffer): Buffer {
+  const newlineIdx = buf.indexOf(0x0a);
+  if (newlineIdx < 0 || !TTYD_CREDENTIAL) return buf;
+  return Buffer.concat([
+    buf.slice(0, newlineIdx + 1),
+    Buffer.from(`authorization: ${TTYD_CREDENTIAL}\r\n`, 'utf8'),
+    buf.slice(newlineIdx + 1),
+  ]);
+}
+
+/** `true` when the request line targets the /ttyd sidecar (GET, any sub-path). */
+function peekTtydRoute(buf: Buffer): boolean | null {
+  const newlineIdx = buf.indexOf(0x0a);
+  if (newlineIdx < 0) return null;
+  const firstLine = buf.slice(0, newlineIdx).toString('ascii');
+  return /^GET\s+\/ttyd(?:\/[^\s]*)?(?:\?[^\s]*)?\s+HTTP\/1\.[01]\r?$/.test(firstLine);
+}
