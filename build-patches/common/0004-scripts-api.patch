+// --- custom scripts API (self-hosted addition) -----------------------------
+// /api/scripts/* is served locally, BEFORE the /api/* proxy below, and gated
+// on a logged-in aionui session — same backendSessionValid probe the ttyd
+// sidecar uses. Two layouts are supported in AIONUI_SCRIPTS_DIR (default
+// /data/scripts.d, a mounted volume):
+//   <name>.sh | <name>.mjs | <name>.py   single-file script (name = filename)
+//   <name>/main.{sh,mjs,py}              package script (name = dir name);
+//                                        resources (.env, watchlists, caches)
+//                                        live next to main.* and the run cwd is
+//                                        that directory
+// Metadata comes from `# name:` / `# desc:` comment heads (or `//` for .mjs).
+// Each run spawns the interpreter picked by the entry's extension (no shell,
+// no user-chosen argv — the attack surface is "run a file that is already on
+// this volume"), tees combined stdout/stderr to
+// AIONUI_SCRIPTS_OUT_DIR/<name>.log and is polled by the UI. Interpretation of
+// the last output line as a view JSON ({type:"table"|"progress"}) happens in
+// the frontend, not here. Runs survive a web restart (detached process group)
+// but their in-memory status does not — the UI just sees running=false.
+const SCRIPTS_DIR = process.env.AIONUI_SCRIPTS_DIR ?? '/data/scripts.d';
+const SCRIPTS_OUT_DIR = process.env.AIONUI_SCRIPTS_OUT_DIR ?? '/data/scripts-output';
+const SCRIPT_INTERPRETERS: Record<string, string> = { '.sh': 'bash', '.mjs': 'node', '.py': 'python3' };
+const SCRIPT_NAME_RE = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;
+
+type ScriptEntry = { name: string; file: string; interpreter: string; dir: string };
+
+/** Discover runnable scripts: top-level *.{sh,mjs,py} files and <dir>/main.* packages. */
+function scanScripts(): ScriptEntry[] {
+  fs.mkdirSync(SCRIPTS_DIR, { recursive: true });
+  const out: ScriptEntry[] = [];
+  const entries = fs.readdirSync(SCRIPTS_DIR, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name));
+  for (const entry of entries) {
+    if (entry.isFile()) {
+      const interpreter = SCRIPT_INTERPRETERS[path.extname(entry.name)];
+      if (interpreter) out.push({ name: entry.name, file: path.join(SCRIPTS_DIR, entry.name), interpreter, dir: SCRIPTS_DIR });
+    } else if (entry.isDirectory()) {
+      for (const ext of ['.sh', '.mjs', '.py']) {
+        const file = path.join(SCRIPTS_DIR, entry.name, `main${ext}`);
+        if (fs.existsSync(file)) {
+          out.push({ name: entry.name, file, interpreter: SCRIPT_INTERPRETERS[ext], dir: path.dirname(file) });
+          break;
+        }
+      }
+    }
+  }
+  return out;
+}
+
+type RunningScript = { proc: ChildProcess; startedAt: number; exitCode?: number | null };
+const runningScripts = new Map<string, RunningScript>();
+
+function scriptOutputPath(name: string): string {
+  return path.join(SCRIPTS_OUT_DIR, `${name}.log`);
+}
+
+/** Parse `# name:` / `# desc:` / `# input-file:` (or `//` for JS) comments from the entry's head. */
+const SCRIPT_META_KEYS = { name: 'name', desc: 'desc', 'input-file': 'inputFile' } as const;
+
+function parseScriptMeta(content: string): { name?: string; desc?: string; inputFile?: string } {
+  const meta: { name?: string; desc?: string; inputFile?: string } = {};
+  for (const line of content.split('\n', 40)) {
+    const m = line.match(/^\s*(?:#|\/\/)\s*(name|desc|input-file)\s*:\s*(.+?)\s*$/i);
+    if (m) {
+      // toLowerCase alone keeps the hyphen ('input-file'); map it explicitly
+      // to the camelCase field or the declaration silently never matches.
+      const key = SCRIPT_META_KEYS[m[1].toLowerCase() as keyof typeof SCRIPT_META_KEYS];
+      if (key && !meta[key]) meta[key] = m[2];
+    }
+  }
+  return meta;
+}
+
+function listScripts(): unknown[] {
+  const out: unknown[] = [];
+  for (const entry of scanScripts()) {
+    // One broken script (unreadable entry, weird metadata) must not blank the
+    // whole list — skip the entry and keep going.
+    try {
+      const record = runningScripts.get(entry.name);
+      const running = record !== undefined && record.exitCode === undefined;
+      const meta = parseScriptMeta(fs.readFileSync(entry.file, 'utf8'));
+      // A declared input file (relative to the entry dir) becomes the panel's
+      // default stdin: the list shows it, edits in the panel override it for
+      // that run. Scripts without a declaration get no stdin box at all.
+      let input: string | undefined;
+      if (meta.inputFile && /^[^/\\]+$/.test(meta.inputFile)) {
+        input = fs.readFileSync(path.join(entry.dir, meta.inputFile), 'utf8').slice(0, 8192);
+      }
+      out.push({
+        name: entry.name,
+        meta: { name: meta.name, desc: meta.desc },
+        input,
+        running,
+        startedAt: running ? record?.startedAt : undefined,
+        exitCode: record?.exitCode,
+      });
+    } catch {
+      /* skip unreadable entry */
+    }
+  }
+  return out;
+}
+
+/** Spawn a script: own process group, output tee'd to its log, optional stdin. */
+function startScript(name: string, stdin: string | undefined): void {
+  const entry = scanScripts().find((s) => s.name === name);
+  if (!entry) throw new Error('UNKNOWN_SCRIPT');
+  const prev = runningScripts.get(name);
+  if (prev !== undefined && prev.exitCode === undefined) throw new Error('ALREADY_RUNNING');
+  fs.mkdirSync(SCRIPTS_OUT_DIR, { recursive: true });
+  const log = fs.createWriteStream(scriptOutputPath(name), { flags: 'w' });
+  const proc = spawn(entry.interpreter, [entry.file], {
+    cwd: entry.dir, // package scripts read sibling resources relative to themselves
+    detached: true, // own process group → stop() can SIGTERM the whole group
+    env: process.env, // inherit HOME etc. so tools like `gh` find their config
+    stdio: ['pipe', 'pipe', 'pipe'],
+  });
+  proc.stdout?.pipe(log);
+  proc.stderr?.pipe(log);
+  const record: RunningScript = { proc, startedAt: Date.now() };
+  runningScripts.set(name, record);
+  proc.on('close', (code) => {
+    record.exitCode = code ?? -1;
+    log.end();
+  });
+  proc.on('error', (err) => {
+    log.write(`\n[spawn error] ${String(err)}\n`);
+    record.exitCode = -1;
+    log.end();
+  });
+  proc.stdin?.end(stdin ?? '');
+}
+
+function stopScript(name: string): void {
+  const record = runningScripts.get(name);
+  if (!record || record.exitCode !== undefined) return;
+  const pid = record.proc.pid;
+  try {
+    if (pid) process.kill(-pid, 'SIGTERM'); // negative pid = the whole group
+    else record.proc.kill('SIGTERM');
+  } catch {
+    try {
+      record.proc.kill('SIGTERM');
+    } catch {
+      /* already gone */
+    }
+  }
+}
+
+function readBody(req: IncomingMessage): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const chunks: Buffer[] = [];
+    req.on('data', (chunk) => chunks.push(chunk));
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+/** Local routes for /api/scripts/* — must be checked before the /api/* proxy. */
+async function handleScriptsApi(req: IncomingMessage, res: ServerResponse, backendPort: number): Promise<void> {
+  const send = (status: number, body: unknown): void => {
+    res.writeHead(status, { 'content-type': 'application/json; charset=utf-8' });
+    res.end(JSON.stringify(body));
+  };
+  if (!(await backendSessionValid(req.headers.cookie, backendPort))) {
+    res.writeHead(401).end('unauthorized');
+    return;
+  }
+  const url = new URL(req.url ?? '/', 'http://localhost');
+  const sub = url.pathname.replace(/^\/api\/scripts\/?/, '').replace(/\/+$/, '');
+  const name = (url.searchParams.get('name') ?? '').trim();
+
+  if (req.method === 'GET' && sub === 'list') {
+    send(200, { scripts: listScripts() });
+  } else if (req.method === 'GET' && sub === 'output' && SCRIPT_NAME_RE.test(name)) {
+    let content = '';
+    try {
+      content = fs.readFileSync(scriptOutputPath(name), 'utf8');
+    } catch {
+      /* not run yet */
+    }
+    if (content.length > 128 * 1024) content = content.slice(-128 * 1024); // keep the tail
+    const record = runningScripts.get(name);
+    const running = record !== undefined && record.exitCode === undefined;
+    send(200, { name, running, exitCode: record?.exitCode, content });
+  } else if (req.method === 'POST' && sub === 'run') {
+    const body = JSON.parse((await readBody(req)) || '{}') as { name?: string; stdin?: string };
+    const target = String(body.name ?? '').trim();
+    if (!SCRIPT_NAME_RE.test(target)) return send(400, { error: 'BAD_SCRIPT_NAME' });
+    try {
+      startScript(target, typeof body.stdin === 'string' ? body.stdin : undefined);
+      send(200, { ok: true, name: target });
+    } catch (e) {
+      const msg = String((e as Error)?.message ?? e);
+      send(msg === 'ALREADY_RUNNING' ? 409 : 404, { error: msg });
+    }
+  } else if (req.method === 'POST' && sub === 'stop') {
+    const body = JSON.parse((await readBody(req)) || '{}') as { name?: string };
+    const target = String(body.name ?? '').trim();
+    if (!SCRIPT_NAME_RE.test(target)) return send(400, { error: 'BAD_SCRIPT_NAME' });
+    stopScript(target);
+    send(200, { ok: true, name: target });
+  } else {
+    send(404, { error: 'NOT_FOUND' });
+  }
+}
